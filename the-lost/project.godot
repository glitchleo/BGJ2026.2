MemoryManager="*uid://da4rkidsxoret"
NpcGenerator="*uid://cucgnaqtwjun1"
MusicManager="*res://scenes/music_manager.tscn"
MemoryUI="*uid://d0vomht4fwjc5"

[display]

window/size/viewport_width=1807
window/size/viewport_height=916
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

interact={
